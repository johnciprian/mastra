{
  "$schema": "https://v2-9-16.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "tsdown.config.ts",
        "tsconfig.json",
        "tsconfig.build.json",
        "package.json",
        "!**/*.md",
        "!**/*.test.ts",
        "!**/*.spec.ts",
        "!**/__tests__/**"
      ],
      "outputs": ["dist/**"]
    },
    "test": {
      // `build`, not `^build`. `^build` is topological only, so this package's
      // own build is not in the graph and the boundary test's built-output
      // assertion has no dist/ to read. `build` already depends on `^build`, so
      // dependencies are still built first.
      "dependsOn": ["build"],
      "inputs": ["src/**", "test/**", "tsconfig.json", "package.json", "vitest.config.*", "!**/*.md"],
      "outputs": []
    }
  }
}
