{
  "name": "@mastra/factory-auth",
  "version": "0.1.0",
  "description": "Provider-agnostic auth for the Mastra Software Factory: the Apache-2.0 contract surface, identity normalization, an OAuth state codec, host-owned session cookies, and a provider conformance suite",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./contract": {
      "import": {
        "types": "./dist/contract.d.ts",
        "default": "./dist/contract.js"
      },
      "require": {
        "types": "./dist/contract.d.ts",
        "default": "./dist/contract.cjs"
      }
    },
    "./identity": {
      "import": {
        "types": "./dist/identity.d.ts",
        "default": "./dist/identity.js"
      },
      "require": {
        "types": "./dist/identity.d.ts",
        "default": "./dist/identity.cjs"
      }
    },
    "./capabilities": {
      "import": {
        "types": "./dist/capabilities.d.ts",
        "default": "./dist/capabilities.js"
      },
      "require": {
        "types": "./dist/capabilities.d.ts",
        "default": "./dist/capabilities.cjs"
      }
    },
    "./organizations": {
      "import": {
        "types": "./dist/organizations.d.ts",
        "default": "./dist/organizations.js"
      },
      "require": {
        "types": "./dist/organizations.d.ts",
        "default": "./dist/organizations.cjs"
      }
    },
    "./cookie": {
      "import": {
        "types": "./dist/cookie.d.ts",
        "default": "./dist/cookie.js"
      },
      "require": {
        "types": "./dist/cookie.d.ts",
        "default": "./dist/cookie.cjs"
      }
    },
    "./oauth-state": {
      "import": {
        "types": "./dist/oauth-state.d.ts",
        "default": "./dist/oauth-state.js"
      },
      "require": {
        "types": "./dist/oauth-state.d.ts",
        "default": "./dist/oauth-state.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "require": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.cjs"
      }
    },
    "./conformance": {
      "import": {
        "types": "./dist/conformance/index.d.ts",
        "default": "./dist/conformance/index.js"
      },
      "require": {
        "types": "./dist/conformance/index.d.ts",
        "default": "./dist/conformance/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --silent --config tsdown.config.ts",
    "build:watch": "tsdown --watch --silent --config tsdown.config.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint . && eslint .",
    "lint:fix": "oxlint --fix . && eslint --fix ."
  },
  "keywords": [
    "mastra",
    "auth",
    "software-factory"
  ],
  "author": "",
  "license": "Apache-2.0",
  "homepage": "https://mastra.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastra-ai/mastra.git",
    "directory": "mastracode/factory-auth"
  },
  "bugs": {
    "url": "https://github.com/mastra-ai/mastra/issues"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.61.0-0 <2.0.0-0",
    "vitest": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@internal/lint": "workspace:*",
    "@internal/types-builder": "workspace:*",
    "@mastra/core": "workspace:*",
    "@types/node": "22.20.1",
    "eslint": "^10.7.0",
    "madge": "^8.0.0",
    "tsdown": "0.22.9",
    "typescript": "catalog:",
    "typescript-eslint": "^8.57.0",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
